# Copy this file to .env and fill in secrets/values for your environment.
# Do NOT commit the real .env file; add ".env" to .gitignore.

# Database connection (example for MySQL)
# DATABASE_URL = "mysql+pymysql://username:password@localhost/dbname"
DATABASE_URL=

# Secret key for sessions, tokens, etc.
SECRET_KEY=

# Enable debug mode (True/False)
DEBUG=True

# Frontend URL used for CORS or client links
FRONTEND_URL=http://127.0.0.1:5500
