{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Backend (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "main:app",
        "--reload",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}/backend",
      "preLaunchTask": "Run Tests (pytest)",
      "jinja": false,
      "justMyCode": true
    },
    {
      "name": "Debug Tests (pytest)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-q"
      ],
      "cwd": "${workspaceFolder}",
      "jinja": false,
      "justMyCode": true
    }
  ]
}
